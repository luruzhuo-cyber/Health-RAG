# 对话模型（OpenAI 兼容协议，可指向 OneAPI、vLLM、云厂商）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=30
LLM_RETRIES=2

# API 向量配置；本地模型由 EMBED_BACKEND=local 启用
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=text-embedding-v1

# 重排模型目录（留空则使用词面覆盖度重排）

# 切块与检索
RAG_CHUNK_MAX_CHARS=260
RAG_CHUNK_OVERLAP=60
RAG_TOP_K=5
RAG_RRF_K=60

HF_HOME=D:/Coding/projrct/.model-cache
EMBED_BACKEND=local
LOCAL_EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
